# SQLite local. To use MySQL, leave DATABASE_URL blank and fill DB_*.
DATABASE_URL=sqlite:///./job_matching.db
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=job_matching

# Required. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Optional. Set both values to seed an admin on a fresh database.
ADMIN_EMAIL=
ADMIN_PASSWORD=

UPLOAD_DIR=uploads/cv
MAX_CV_SIZE_MB=5
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
